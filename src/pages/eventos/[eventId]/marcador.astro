---
// src/pages/eventos/[eventId]/marcador.astro
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../layouts/Navbar.astro";
import Footer from "../../../layouts/Footer.astro";
import EventNavbar from "../../../shared/components/EventNavbar.astro";
import { getEventBySlug } from "../../../shared/lib/events";
import { getStandings, getSeason } from "../../../features/parsec-league/lib/leagueData";
import SeasonChampion from "../../../features/parsec-league/components/SeasonChampion.astro";

export function getStaticPaths() {
  return [
    { params: { eventId: 'parsec-league' } }
  ];
}

const { eventId } = Astro.params;
const event = getEventBySlug(eventId);

if (!event) return Astro.redirect('/404');

const [standings, season] = await Promise.all([getStandings(), getSeason()]);
const isFinished = season?.status === 'finished';
const championName = season?.champion?.name ?? null;
---

<Layout title={`Marcador - ${event.title}`}>
    <Navbar />
    <EventNavbar eventSlug={event.slug} eventName={event.title} />

    <section class="max-w-6xl mx-auto px-4 py-24">
      {isFinished && season?.champion && (
      <SeasonChampion champion={{
        name: season.champion.name,
        logo: season.champion.logo ?? undefined,
        played: season.champion.played,
        won: season.champion.won,
        drawn: season.champion.drawn,
        lost: season.champion.lost,
        gf: season.champion.gf,
        ga: season.champion.ga,
        gd: season.champion.gd,
        points: season.champion.points,
      }} />
    )}

      <div class="mb-8">
        <div class="flex items-center gap-3 flex-wrap">
          <h2 class="text-2xl font-orbitron font-bold text-green-500 uppercase tracking-wider">
            Clasificación Parsec League
          </h2>
          {isFinished && (
            <span class="px-3 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/40 text-yellow-400 text-[10px] font-bold uppercase tracking-widest">
              Temporada Finalizada
            </span>
          )}
        </div>
        <p class="text-gray-500 text-sm mt-1">Clasificación final</p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-white/5 bg-zinc-900/20 backdrop-blur-sm">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-zinc-900/80 text-zinc-400 text-[11px] uppercase tracking-widest border-b border-white/10">
              <th class="px-6 py-4 font-bold">Pos</th>
              <th class="px-6 py-4 font-bold">Club</th>
              <th class="px-4 py-4 font-bold text-center">Pj</th>
              <th class="px-4 py-4 font-bold text-center">G</th>
              <th class="px-4 py-4 font-bold text-center">E</th>
              <th class="px-4 py-4 font-bold text-center">P</th>
              <th class="px-4 py-4 font-bold text-center">Gf</th>
              <th class="px-4 py-4 font-bold text-center">Gc</th>
              <th class="px-4 py-4 font-bold text-center">Dg</th>
              <th class="px-6 py-4 font-bold text-center text-green-500">Pts</th>
              <th class="px-6 py-4 font-bold">Forma</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {standings.map((team) => {
              const isChamp = isFinished && team.name === championName;
              return (
              <tr class={`transition-colors group ${isChamp ? 'bg-yellow-500/5 border-l-2 border-yellow-500' : 'hover:bg-white/2'}`}>
                <td class="px-6 py-4">
                  <span class={`text-sm font-bold ${isChamp ? 'text-yellow-400' : team.position <= 3 ? 'text-green-500' : 'text-zinc-500'}`}>
                    {isChamp ? '👑' : team.position}
                  </span>
                </td>
                <td class="px-6 py-2">
                  <div class="flex items-center gap-3">
                    <img src={team.logo} alt={team.name} class={`rounded-full w-8 h-8 object-contain ${isChamp ? 'ring-1 ring-yellow-500/60' : ''}`} />
                    <span class={`text-sm font-semibold transition-colors ${isChamp ? 'text-yellow-300 font-bold' : 'text-zinc-200 group-hover:text-white'}`}>
                      {team.name}
                    </span>
                  </div>
                </td>
                <td class="px-4 py-4 text-center text-sm text-zinc-400">{team.played}</td>
                <td class="px-4 py-4 text-center text-sm text-zinc-400">{team.won}</td>
                <td class="px-4 py-4 text-center text-sm text-zinc-400">{team.drawn}</td>
                <td class="px-4 py-4 text-center text-sm text-zinc-400">{team.lost}</td>
                <td class="px-4 py-4 text-center text-sm text-zinc-400">{team.gf}</td>
                <td class="px-4 py-4 text-center text-sm text-zinc-400">{team.ga}</td>
                <td class="px-4 py-4 text-center text-sm font-mono {team.gd > 0 ? 'text-green-500/70' : team.gd < 0 ? 'text-red-500/70' : 'text-zinc-500'}">
                  {team.gd > 0 ? `+${team.gd}` : team.gd}
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="text-base font-black text-green-500 drop-shadow-[0_0_8px_rgba(34,197,94,0.3)]">
                    {team.points}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="flex gap-1 justify-start">
                    {team.form?.map((result) => (
                      <span class={`w-5 h-5 rounded-sm flex items-center justify-center text-[10px] font-bold text-white
                        ${result === 'W' ? 'bg-green-600' : result === 'D' ? 'bg-zinc-600' : 'bg-red-600'}`}>
                        {result}
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            ); })}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap');
  .font-orbitron { font-family: 'Orbitron', sans-serif; }
</style>