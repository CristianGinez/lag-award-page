---
import Layout from '../layouts/Layout.astro';
import Navbar from '../layouts/Navbar.astro';
import Footer from '../layouts/Footer.astro';
import UserInfo from '../features/profile/components/UserInfo.astro';
import { getCategories, EVENT_ID_2025 } from '../features/awards/lib/awardsData';
import { BadgeShowcase } from '../features/achievements/components/BadgeShowcase';
import { UnlockToast } from '../features/achievements/components/UnlockToast';
import { getSupabase } from '../features/auth/lib/supabase';
import { getVipForUser } from '../features/community/lib/vipsData';

const ssrSupabase = getSupabase(Astro);
const { data: { user: ssrUser } } = await ssrSupabase.auth.getUser();
const vipProfile = ssrUser ? await getVipForUser(ssrUser.id) : null;

const perfilCategories = await getCategories(EVENT_ID_2025);
---

<Layout title="Mi Perfil - LAGAWARDS">
  <Navbar />

  <main class="min-h-screen text-white bg-[#050505]">

    <!-- Loading state -->
    <div id="loading-state" class="flex flex-col items-center justify-center pt-40 pb-20">
      <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500"></div>
    </div>

    <!-- Unauthorized -->
    <div id="unauthorized-message" class="hidden text-center pt-40 pb-20">
      <h2 class="text-2xl font-bold text-red-500 mb-4">Acceso Restringido</h2>
      <a href="/login" class="underline hover:text-white">Iniciar Sesión</a>
    </div>

    <!-- Profile content -->
    <div id="profile-content" class="hidden opacity-0 transition-opacity duration-500">

      <!-- ── BANNER ────────────────────────────────────────────── -->
      <div
        class="w-full relative overflow-hidden"
        style="height: 220px; margin-top: 64px; background: linear-gradient(to bottom, rgba(5,5,5,0) 40%, #050505 100%), linear-gradient(135deg, #0d0020 0%, #0a0a1e 30%, #100a00 60%, #0a001a 100%);"
      >
        <!-- Grid pattern -->
        <div
          class="absolute inset-0"
          style="background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px); background-size: 40px 40px;"
        ></div>
        <!-- Glow orbs -->
        <div
          class="absolute inset-0"
          style="background: radial-gradient(ellipse at 20% 50%, rgba(124,58,237,0.2) 0%, transparent 50%), radial-gradient(ellipse at 80% 30%, rgba(219,39,119,0.15) 0%, transparent 50%), radial-gradient(ellipse at 60% 80%, rgba(245,158,11,0.08) 0%, transparent 40%);"
        ></div>
      </div>

      <!-- ── PROFILE HEADER ────────────────────────────────────── -->
      <div class="max-w-[900px] mx-auto px-6 relative z-10 -mt-14 flex items-end gap-5 mb-5">
        <UserInfo />
        {vipProfile && (
          <div class="pb-3.5 shrink-0">
            <span
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full border text-[9px] font-bold font-mono uppercase tracking-widest"
              style={`background: ${vipProfile.color}10; border-color: ${vipProfile.color}30; color: ${vipProfile.color};`}
            >
              ★ VIP
            </span>
          </div>
        )}
      </div>

      <!-- ── BODY GRID ─────────────────────────────────────────── -->
      <div class="max-w-[900px] mx-auto px-6 pb-20 grid grid-cols-1 md:grid-cols-[200px_1fr] gap-3 items-start">

        <!-- SIDEBAR -->
        <aside class="flex flex-col gap-3 md:sticky md:top-5">

          <!-- Stats block -->
          <div class="rounded-[14px] border border-white/[0.06] bg-white/[0.03] overflow-hidden">
            <div class="px-3.5 py-2.5 border-b border-white/[0.04]">
              <span class="text-[9px] font-bold font-mono uppercase tracking-[0.25em] text-gray-700">Stats</span>
            </div>
            <div class="px-3.5 py-3 flex flex-col gap-0">
              <div class="flex justify-between items-center py-1.5 border-b border-white/[0.03]">
                <span class="text-[10px] text-gray-500 font-mono">Logros</span>
                <span id="stat-logros" class="text-xs font-bold text-gray-300">—</span>
              </div>
              <div class="flex justify-between items-center py-1.5 border-b border-white/[0.03]">
                <span class="text-[10px] text-gray-500 font-mono">Votos emitidos</span>
                <span id="stat-votos" class="text-xs font-bold text-gray-300">—</span>
              </div>
              <div class="flex justify-between items-center py-1.5">
                <span class="text-[10px] text-gray-500 font-mono">Miembro desde</span>
                <span id="stat-since" class="text-[10px] font-bold text-gray-500">—</span>
              </div>
            </div>
          </div>

          <!-- VIP link (if applicable) -->
          {vipProfile && (
            <div
              class="rounded-[14px] border p-3.5 flex items-center gap-3"
              style={`border-color: ${vipProfile.color}25; background: ${vipProfile.color}08;`}
            >
              <div
                class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black font-orbitron border shrink-0"
                style={`background: ${vipProfile.color}15; border-color: ${vipProfile.color}30; color: ${vipProfile.color};`}
              >
                {vipProfile.name.charAt(0)}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[9px] font-bold uppercase tracking-widest font-mono" style={`color: ${vipProfile.color};`}>VIP del TeamLag</p>
                <p class="text-white font-black font-orbitron text-[11px] uppercase truncate">{vipProfile.name}</p>
              </div>
              <a
                href={`/vips/${vipProfile.slug}`}
                class="shrink-0 text-[9px] font-bold transition-colors hover:text-white font-mono"
                style={`color: ${vipProfile.color};`}
              >
                Ver →
              </a>
            </div>

            <!-- Editar perfil VIP -->
            <a
              href="/perfil/editar"
              class="flex items-center justify-center gap-2 w-full py-2.5 rounded-[10px] border border-purple-500/20 hover:border-purple-500/50 text-purple-400/70 hover:text-purple-300 text-[10px] font-bold font-mono uppercase tracking-[0.15em] transition-all bg-purple-500/5 hover:bg-purple-500/10"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"/>
              </svg>
              Editar perfil VIP
            </a>
          )}

          <!-- Sign out -->
          <button
            id="sign-out-btn"
            class="cursor-pointer w-full py-2.5 rounded-[10px] border border-red-500/10 hover:border-red-500/30 text-red-500/35 hover:text-red-500/60 text-[10px] font-bold font-mono uppercase tracking-[0.15em] transition-all bg-transparent"
          >
            Cerrar Sesión
          </button>

        </aside>

        <!-- MAIN CONTENT -->
        <div class="flex flex-col gap-3">

          <!-- Vitrina de logros -->
          <div class="rounded-[14px] border border-white/[0.06] bg-white/[0.03] overflow-hidden">
            <div class="px-4 py-4">
              <BadgeShowcase client:load />
            </div>
          </div>

          <!-- Discord linking section -->
          <div id="discord-section" class="hidden rounded-[14px] border border-white/[0.06] bg-white/[0.03] overflow-hidden">
            <div class="px-4 py-3 border-b border-white/[0.04]">
              <span class="text-[9px] font-bold font-mono uppercase tracking-[0.25em] text-gray-700">Cuenta de Discord</span>
            </div>
            <div class="px-4 py-4">
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-[10px] bg-[#5865F2]/10 border border-[#5865F2]/18 flex items-center justify-center shrink-0">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="#5865F2"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/></svg>
                  </div>
                  <div>
                    <p id="discord-status-text" class="text-[11px] text-gray-500 font-mono">Cargando…</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span id="discord-linked-badge" class="hidden items-center gap-1.5 text-[10px] font-bold text-green-400 bg-green-500/10 border border-green-500/20 px-2 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                    Vinculada
                  </span>
                  <button id="discord-connect-btn" class="hidden cursor-pointer text-[10px] font-bold font-mono uppercase tracking-[0.08em] px-4 py-2 rounded-lg bg-[#5865F2] hover:bg-[#4752c4] text-white transition-colors">
                    Conectar Discord
                  </button>
                  <button id="discord-unlink-btn" class="hidden cursor-pointer text-xs text-red-400/60 hover:text-red-400 border border-transparent hover:border-red-500/20 px-3 py-1.5 rounded-lg transition-all">
                    Desvincular
                  </button>
                </div>
              </div>
              <div id="discord-toast" class="hidden mt-3 text-xs rounded-lg px-3 py-2 font-mono"></div>
            </div>
          </div>

          <!-- Votes accordion (UNTOUCHED) -->
          <div id="votes-accordion" class="hidden border-2 border-white rounded-none md:rounded-lg overflow-hidden bg-[#0a0a0a]">
            <button id="votes-toggle" class="cursor-pointer w-full px-4 py-1 bg-white text-black flex justify-between items-center hover:bg-gray-200 transition-colors group">
              <h3 class="text-xl md:text-sm font-black font-orbitron uppercase tracking-tighter">
                TUS VOTOS 2025
              </h3>
              <div class="flex items-center gap-3">
                <span id="vote-count-badge" class="text-xs font-bold bg-black text-white px-2 py-1 rounded hidden md:block">0 Votos</span>
                <svg id="chevron-icon" class="w-6 h-6 transform transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </button>
            <div id="votes-content" class="hidden transition-all duration-300 ease-in-out border-t border-white/10">
              <div class="p-2 bg-[#111]">
                <div id="votes-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3"></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div id="perfil-categories-data" data-json={JSON.stringify(perfilCategories)} class="hidden" aria-hidden="true"></div>

  </main>

  <Footer />
  <UnlockToast client:idle />
</Layout>

<script>
  import { $currentUser } from '../features/auth/stores/authStore';
  import { getUserVotes } from '../features/awards/lib/voting';
  import { supabase } from '../features/auth/lib/supabase';
  import { startDiscordLink, syncDiscordIdToProfile, unlinkDiscord } from '../features/auth/lib/discordLink';
  const categories = JSON.parse((document.getElementById('perfil-categories-data') as HTMLElement)?.dataset.json || '[]');

  document.addEventListener('astro:page-load', async () => {

    document.getElementById('sign-out-btn')?.addEventListener('click', async (e) => {
      e.preventDefault();
      const { error } = await supabase.auth.signOut();
      if (!error) window.location.href = '/login';
    });

    const loadingState = document.getElementById('loading-state');
    const profileContent = document.getElementById('profile-content');
    const unauthorizedMsg = document.getElementById('unauthorized-message');
    const avatarEl = document.getElementById('profile-avatar') as HTMLImageElement;
    const nameEl = document.getElementById('profile-name');
    const emailEl = document.getElementById('profile-email');
    const votesAccordion = document.getElementById('votes-accordion');
    const votesGrid = document.getElementById('votes-grid');
    const voteCountBadge = document.getElementById('vote-count-badge');
    const toggleBtn = document.getElementById('votes-toggle');
    const votesContent = document.getElementById('votes-content');
    const chevron = document.getElementById('chevron-icon');
    const statLogros = document.getElementById('stat-logros');
    const statVotos = document.getElementById('stat-votos');
    const statSince = document.getElementById('stat-since');

    if (toggleBtn && votesContent && chevron) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = votesContent.classList.contains('hidden');
        if (isHidden) {
          votesContent.classList.remove('hidden');
          chevron.style.transform = 'rotate(180deg)';
        } else {
          votesContent.classList.add('hidden');
          chevron.style.transform = 'rotate(0deg)';
        }
      });
    }

    // Use getUser() directly — avoids race condition after OAuth redirects (e.g. Discord)
    let user = $currentUser.get();
    if (!user) {
      const { data: { user: freshUser } } = await supabase.auth.getUser();
      user = freshUser as typeof user;
    }

    if (!user) {
      loadingState?.classList.add('hidden');
      unauthorizedMsg?.classList.remove('hidden');
      return;
    }

    const userName = user.user_metadata?.full_name || 'Usuario';
    const userImg = user.user_metadata?.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(userName)}&background=random`;

    if (avatarEl) avatarEl.src = userImg;
    if (nameEl) nameEl.textContent = userName;
    if (emailEl) emailEl.textContent = user.email;

    // Member since
    if (statSince && user.created_at) {
      const d = new Date(user.created_at);
      statSince.textContent = d.toLocaleDateString('es-AR', { month: 'short', year: 'numeric' });
    }

    // Votes
    const myVotes = await getUserVotes();
    const voteKeys = Object.keys(myVotes);
    const count = voteKeys.length;

    if (statVotos) statVotos.textContent = String(count);

    if (count > 0) {
      votesAccordion?.classList.remove('hidden');
      if (votesGrid) {
        votesGrid.innerHTML = '';
        categories.forEach((cat: { id: string; title: string }) => {
          const votedName = myVotes[cat.id];
          if (votedName) {
            const box = document.createElement('div');
            box.className = 'bg-white/5 border border-white/10 rounded-lg p-2 flex flex-col items-center justify-center text-center gap-2 hover:bg-white/10 hover:border-purple-500/50 transition-all group/box cursor-default h-16 relative overflow-hidden';
            box.innerHTML = `
              <div class="absolute top-1 right-2 text-green-500 text-xs opacity-50">✓</div>
              <div class="w-full overflow-hidden">
                <p class="text-[10px] text-gray-400 uppercase font-bold truncate px-1">${cat.title}</p>
                <p class="text-xs text-white font-bold leading-tight mt-1 line-clamp-2 text-blue-300">${votedName}</p>
              </div>
            `;
            votesGrid.appendChild(box);
          }
        });
      }
      if (voteCountBadge) voteCountBadge.textContent = `${count} Votos`;
    } else {
      votesAccordion?.classList.add('hidden');
    }

    // Badge count (separate lightweight fetch)
    try {
      const { data: badgesData } = await supabase.rpc('get_badges_with_progress', { target_user_id: user.id });
      const badgeCount = (badgesData as { unlocked: boolean }[] | null)?.filter(b => b.unlocked).length ?? 0;
      if (statLogros) statLogros.textContent = String(badgeCount);
    } catch {
      if (statLogros) statLogros.textContent = '0';
    }

    loadingState?.classList.add('hidden');
    profileContent?.classList.remove('hidden');
    setTimeout(() => profileContent?.classList.remove('opacity-0'), 50);

    // ── Discord linking ──────────────────────────────────────────────
    const discordSection = document.getElementById('discord-section');
    const statusText = document.getElementById('discord-status-text');
    const linkedBadge = document.getElementById('discord-linked-badge');
    const connectBtn = document.getElementById('discord-connect-btn');
    const unlinkBtn = document.getElementById('discord-unlink-btn');
    const toast = document.getElementById('discord-toast');

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = `mt-3 text-xs rounded-lg px-3 py-2 font-mono ${isError ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 'bg-green-500/10 text-green-400 border border-green-500/20'}`;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 5000);
    }

    const params = new URLSearchParams(window.location.search);
    if (params.get('linked') === 'discord') {
      history.replaceState({}, '', '/perfil');
      const result = await syncDiscordIdToProfile();
      if (result.ok) {
        showToast('¡Discord vinculado correctamente! 🎉');
      } else if (result.reason === 'already-linked-to-another') {
        showToast('Esa cuenta de Discord ya está vinculada a otro perfil.', true);
      } else {
        showToast('No se pudo guardar la vinculación. Intentá de nuevo.', true);
      }
    }

    async function renderDiscordState() {
      const { data: { user: freshUser } } = await supabase.auth.getUser();
      if (!freshUser) return;

      // profiles.discord_id is the source of truth — identities array is not reliably populated by getUser()
      const { data: profile } = await supabase
        .from('profiles')
        .select('discord_id')
        .eq('id', freshUser.id)
        .maybeSingle();

      const hasDiscord = Boolean(profile?.discord_id);

      // Username from OAuth identities (best-effort, may be absent)
      const discordUsername =
        freshUser?.identities?.find((i) => i.provider === 'discord')
          ?.identity_data?.['full_name'] as string | undefined ??
        freshUser?.identities?.find((i) => i.provider === 'discord')
          ?.identity_data?.['name'] as string | undefined;

      discordSection?.classList.remove('hidden');

      if (hasDiscord) {
        if (statusText) statusText.textContent = discordUsername ? `@${discordUsername}` : 'Vinculada';
        linkedBadge?.classList.remove('hidden');
        linkedBadge?.classList.add('flex');
        connectBtn?.classList.add('hidden');
        unlinkBtn?.classList.remove('hidden');
      } else {
        if (statusText) statusText.textContent = 'No vinculada — conectá tu Discord al sitio';
        linkedBadge?.classList.add('hidden');
        connectBtn?.classList.remove('hidden');
        unlinkBtn?.classList.add('hidden');
      }
    }

    await renderDiscordState();

    connectBtn?.addEventListener('click', async () => {
      connectBtn.textContent = 'Redirigiendo…';
      (connectBtn as HTMLButtonElement).disabled = true;
      const { error } = await startDiscordLink();
      if (error) {
        connectBtn.textContent = 'Conectar Discord';
        (connectBtn as HTMLButtonElement).disabled = false;
        showToast('No se pudo iniciar la vinculación. Intentá de nuevo.', true);
      }
    });

    unlinkBtn?.addEventListener('click', async () => {
      if (!confirm('¿Desvincular tu cuenta de Discord?')) return;
      unlinkBtn.textContent = 'Desvinculando…';
      (unlinkBtn as HTMLButtonElement).disabled = true;
      const result = await unlinkDiscord();
      if (result.ok) {
        showToast('Discord desvinculado.');
        await renderDiscordState();
      } else {
        unlinkBtn.textContent = 'Desvincular';
        (unlinkBtn as HTMLButtonElement).disabled = false;
        showToast('No se pudo desvincular. Intentá de nuevo.', true);
      }
    });
  });
</script>
