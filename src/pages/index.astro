---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../layouts/Navbar.astro';
import Hero from '../shared/components/Hero.astro';
import Footer from '../layouts/Footer.astro';
import categories from '../features/awards/data/categories';
import { getWinners } from '../features/awards/lib/voting';
import { getCached } from '../shared/lib/cache';
import { optimizeUrl } from '../shared/lib/imageOptimizer';

// 1. OBTENER GANADORES (Lógica Server-Side, cacheado 60s en KV)
const EVENT_ID_2025 = '856a7c16-5436-4776-a844-04dcaafb4656'; // Tu UUID Real
const winnersData = await getCached(
  { key: `winners:${EVENT_ID_2025}`, ttl: 60 },
  () => getWinners(EVENT_ID_2025)
);

// Mapear ganadores
const winnersCompact = categories.map(cat => {
    const winnerInfo = winnersData.find((w: any) => w.category_id === cat.id);
    if (!winnerInfo) return null; 
    const nomineeDetails = cat.nominees.find(n => n.name === winnerInfo.nominee_name);
    
    return {
        category: cat,
        winnerName: winnerInfo.nominee_name,
        details: nomineeDetails ? { ...nomineeDetails, image: optimizeUrl(nomineeDetails.image || '', { width: 300 }) } : { image: '/img/tl_logo.png' }
    };
}).filter(item => item !== null);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout 
  title="TeamLag - Pagina Oficial del Team LAG" 
  description="Pagina Oficial del Team LAG, comunidad de creadores de contenido en español. Descubre nuestros proyectos, eventos y más."
  image="https://res.cloudinary.com/dkjaq3i9p/image/upload/v1768785502/PORTADA_vzoqne.jpg"
>
    <Navbar />
    
    <main class="bg-[#050505] min-h-screen">
        <Hero />

      

    </main>
    <Footer />
</Layout>