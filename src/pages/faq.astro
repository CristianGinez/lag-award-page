---
import Layout from '../layouts/Layout.astro';
import Navbar from '../layouts/Navbar.astro';
import Footer from '../layouts/Footer.astro';
import { getCollection, render } from 'astro:content';

const faqs = (await getCollection('faq'))
  .sort((a, b) => a.data.order - b.data.order);

const faqsWithContent = await Promise.all(
  faqs.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const grouped = faqsWithContent.reduce((acc, item) => {
  const cat = item.entry.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {} as Record<string, typeof faqsWithContent>);
---

<Layout title="FAQ - LAG AWARDS">
  <Navbar />
  <main class="pt-24 min-h-screen text-white bg-[#050505]">
    <div class="container mx-auto px-6 py-12 max-w-3xl">
      <h1 class="text-4xl md:text-6xl font-black font-orbitron text-center mb-12">
        PREGUNTAS <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">FRECUENTES</span>
      </h1>

      {Object.entries(grouped).map(([category, items]) => (
        <section class="mb-10">
          <h2 class="text-xs font-bold uppercase tracking-widest text-purple-400 mb-4 font-orbitron">{category}</h2>
          <div class="space-y-4">
            {items.map(({ entry, Content }) => (
              <details class="group bg-[#111] border border-white/10 rounded-xl overflow-hidden transition-all duration-300 hover:border-purple-500/50">
                <summary class="flex justify-between items-center cursor-pointer p-6 font-bold text-lg select-none">
                  {entry.data.question}
                  <span class="transition-transform group-open:rotate-180 text-purple-500">▼</span>
                </summary>
                <div class="px-6 pb-6 text-gray-400 leading-relaxed border-t border-white/5 pt-4 prose prose-invert prose-sm max-w-none">
                  <Content />
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
