<!-- ═══════════════════════════════════════ SCRIPT ═══════════════════════════════════════ -->
<script>
  import { gsap, ScrollTrigger } from '@/shared/lib/gsap';

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-bot-feature]')) return;

    // Feature cards stagger
    gsap.from('[data-bot-feature]', {
      opacity: 0, y: 32, stagger: 0.1, duration: 0.6, ease: 'power3.out',
      scrollTrigger: { trigger: '#features', start: 'top 82%', once: true },
    });

    // Steps stagger
    gsap.from('[data-bot-step]', {
      opacity: 0, y: 24, stagger: 0.15, duration: 0.55, ease: 'power2.out',
      scrollTrigger: { trigger: '[data-bot-step]', start: 'top 85%', once: true },
    });

    // Discord window reveal
    gsap.from('.discord-win', {
      opacity: 0, y: 40, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '.discord-win', start: 'top 85%', once: true },
    });
  });
</script>
