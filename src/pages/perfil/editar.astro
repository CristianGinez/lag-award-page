---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/layouts/Navbar.astro';
import Footer from '@/layouts/Footer.astro';
import { VipEditForm } from '@/features/profile/components/VipEditForm';
---

<Layout title="Editar perfil VIP">
  <Navbar />
  <main class="min-h-screen bg-[#050505] text-white pt-28 pb-24 px-4">
    <div class="max-w-2xl mx-auto">
      <div class="mb-6">
        <a href="/perfil" class="inline-flex items-center gap-2 text-xs font-mono text-gray-500 hover:text-gray-300 transition-colors mb-6">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
          </svg>
          Volver al perfil
        </a>
      </div>
      <!-- Auth y VIP data se cargan client-side (PKCE no usa cookies) -->
      <VipEditForm client:load />
    </div>
  </main>
  <Footer />
</Layout>
