---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/layouts/Navbar.astro';
import Footer from '@/layouts/Footer.astro';
import { getVipBySlug } from '@/features/community/lib/vipsData';
import { getPlatformInfo } from '@/features/community/lib/platformIcons';

const { slug } = Astro.params;
const vip = await getVipBySlug(slug!);

if (!vip) return Astro.redirect('/vips');

const games = vip.favorite_games ?? [];
const aliases = vip.aliases ?? [];
const links = vip.links ?? [];
---

<Layout
  title={`${vip.name} — TeamLag`}
  description={vip.bio ?? `Conocé a ${vip.name}, VIP del TeamLag.`}
  image="/og/default.png"
>
  <Navbar />
  <main class="vip-detail-page pt-24 min-h-screen bg-[#050505]">

    <!-- Hero -->
    <div
      class="relative overflow-hidden border-b border-white/5"
      style={`--vip-color: ${vip.color};`}
    >
      <!-- Background glow -->
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] blur-[120px] opacity-20 rounded-full" style={`background: ${vip.color};`}></div>
      </div>
      <!-- Accent top line -->
      <div class="absolute top-0 left-0 right-0 h-1" style={`background: linear-gradient(90deg, transparent, ${vip.color}, transparent);`}></div>

      <div class="container mx-auto px-4 md:px-6 py-16 md:py-24 max-w-4xl relative z-10">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8">

          <!-- Avatar (shared element — View Transitions lo morfea desde la card) -->
          {vip.avatar ? (
            <img
              src={vip.avatar}
              alt={vip.name}
              transition:name={`vip-avatar-${slug}`}
              width="144"
              height="144"
              decoding="async"
              class="w-28 h-28 md:w-36 md:h-36 rounded-full object-cover border-4 shrink-0"
              style={`border-color: ${vip.color}60; box-shadow: 0 0 40px ${vip.color}30;`}
            />
          ) : (
            <div
              transition:name={`vip-avatar-${slug}`}
              class="w-28 h-28 md:w-36 md:h-36 rounded-full flex items-center justify-center text-5xl font-black font-orbitron border-4 shrink-0"
              style={`background: ${vip.color}15; border-color: ${vip.color}50; color: ${vip.color}; box-shadow: 0 0 40px ${vip.color}25;`}
            >
              {vip.name.charAt(0)}
            </div>
          )}

          <!-- Info -->
          <div class="text-center md:text-left">
            <p data-cascade class="text-[10px] font-bold uppercase tracking-[0.3em] font-mono mb-1" style={`opacity:0;color:${vip.color};`}>{vip.role}</p>
            <div class="flex items-center gap-3 justify-center md:justify-start mb-2">
              <!-- Nombre: shared element — View Transitions lo morfea desde la card -->
              <h1 transition:name={`vip-name-${slug}`} class="text-4xl md:text-5xl font-black font-orbitron text-white uppercase tracking-tight leading-none">{vip.name}</h1>
              {vip.user_id && (
                <span
                  data-cascade
                  style="opacity:0"
                  class="text-xs bg-green-500/20 text-green-400 border border-green-500/40 px-2 py-1 rounded-lg font-mono font-bold shrink-0"
                  title="Este VIP vinculó su cuenta del sitio"
                >
                  ✓ verificado
                </span>
              )}
            </div>

            {aliases.length > 0 && (
              <p data-cascade style="opacity:0" class="text-gray-500 text-sm font-mono mb-3">
                También conocido como: {aliases.join(', ')}
              </p>
            )}

            {vip.origin && (
              <p data-cascade style="opacity:0" class="text-gray-400 text-sm flex items-center justify-center md:justify-start gap-1.5 mb-4">
                <span class="opacity-60">📍</span> {vip.origin}
              </p>
            )}

            <!-- Social links from vip_links -->
            {links.length > 0 && (
              <div data-cascade style="opacity:0" class="flex flex-wrap gap-3 justify-center md:justify-start">
                {links.map((link) => {
                  const info = getPlatformInfo(link.platform);
                  return (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border text-sm font-bold transition-all hover:scale-105"
                      style={`border-color: ${info.color}40; color: ${info.color}; background: ${info.color}12;`}
                    >
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <Fragment set:html={info.svg} />
                      </svg>
                      {link.label ?? info.label}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 md:px-6 py-12 max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Bio (2/3) -->
        <div class="md:col-span-2 space-y-8">
          {vip.bio && (
            <div data-cascade style="opacity:0">
              <h2 class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-500 font-mono mb-4">Bio</h2>
              <p class="text-gray-300 leading-relaxed text-sm whitespace-pre-line">{vip.bio}</p>
            </div>
          )}

          {games.length > 0 && (
            <div data-cascade style="opacity:0">
              <h2 class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-500 font-mono mb-4">Juegos favoritos</h2>
              <div class="flex flex-wrap gap-2">
                {games.map((g) => (
                  <span
                    class="px-3 py-1.5 rounded-xl border text-sm font-mono"
                    style={`border-color: ${vip.color}30; background: ${vip.color}08; color: ${vip.color};`}
                  >{g}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar (1/3) -->
        <div class="space-y-6">
          {vip.music && (
            <div data-cascade style="opacity:0" class="p-4 rounded-2xl border border-white/5 bg-white/3">
              <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-500 font-mono mb-3">Música</h3>
              <p class="text-gray-300 text-sm leading-relaxed">{vip.music}</p>
            </div>
          )}

          <div data-cascade style="opacity:0" class="p-4 rounded-2xl border border-white/5 bg-white/3">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-500 font-mono mb-3">Identidad</h3>
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded-full border border-white/20" style={`background: ${vip.color};`}></div>
              <span class="text-gray-400 text-sm">{vip.color_name ?? vip.color}</span>
            </div>
          </div>

          <a data-cascade style="opacity:0" href="/vips" class="block text-center text-xs text-gray-600 hover:text-gray-400 transition-colors font-mono py-2">
            ← Volver al Team
          </a>
        </div>

      </div>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  import { gsap } from '@/shared/lib/gsap';

  function runCascade() {
    if (!window.location.pathname.match(/^\/vips\/.+/)) return;

    const elements = document.querySelectorAll('[data-cascade]');
    if (!elements.length) return;

    // Asegurar estado inicial (necesario si el usuario navega directo a la página)
    gsap.set(elements, { opacity: 0, y: 14 });

    gsap.to(elements, {
      opacity: 1,
      y: 0,
      stagger: 0.09,
      duration: 0.45,
      ease: 'power3.out',
      delay: 0.08,
      clearProps: 'transform',
    });
  }

  // Después de una transición de View Transitions
  document.addEventListener('astro:page-load', runCascade);
</script>
