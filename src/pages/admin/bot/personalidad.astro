---
import BotAdminLayout from '@/features/bot-admin/components/BotAdminLayout.astro';
import PersonalityView from '@/features/bot-admin/components/PersonalityView.tsx';
import { convex } from '@/features/bot-admin/lib/convexClient';
import { isAdminPage } from '@/features/bot-admin/lib/pageAuth';

if (!await isAdminPage(Astro)) return Astro.redirect('/');

let personality: any = null;
try {
  personality = await convex.query('personality:getPersonality' as any, { scope: 'global' });
} catch (_) {}
---

<BotAdminLayout title="Personalidad del Bot" active="personalidad">
  <PersonalityView client:load initialPersonality={personality} />
</BotAdminLayout>
