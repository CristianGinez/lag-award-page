---
import BotAdminLayout from '@/features/bot-admin/components/BotAdminLayout.astro';
import StreamersManager from '@/features/bot-admin/components/StreamersManager.tsx';
import { convex } from '@/features/bot-admin/lib/convexClient';




let initialStreamers: any[] = [];
try {
  initialStreamers = await convex.query('streamers:list' as any, {});
} catch (_) {}
---

<BotAdminLayout title="Streamers Tracking" active="streamers">
  <StreamersManager client:load initialStreamers={initialStreamers} />
</BotAdminLayout>
