---
import BotAdminLayout from '@/features/bot-admin/components/BotAdminLayout.astro';
import ReactionRolesManager from '@/features/bot-admin/components/ReactionRolesManager.tsx';
import { convex } from '@/features/bot-admin/lib/convexClient';
import { getSupabase } from '@/features/auth/lib/supabase';

const supabase = getSupabase(Astro);
const { data: { user } } = await supabase.auth.getUser();
if (!user?.app_metadata?.is_admin) return Astro.redirect('/');

let initialRoles: any[] = [];
try {
  initialRoles = await convex.query('reactionRoles:listAll' as any, {});
} catch (_) {}
---

<BotAdminLayout title="Reaction Roles" active="reaction-roles">
  <ReactionRolesManager client:load initialRoles={initialRoles} />
</BotAdminLayout>
