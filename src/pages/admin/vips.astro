---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../layouts/Navbar.astro';
import Footer from '../../layouts/Footer.astro';
import { VipsManager } from '../../features/community/components/VipsManager';
import { getAllVips } from '../../features/community/lib/vipsData';

const vips = await getAllVips();
---

<Layout title="Admin — VIPs">
  <Navbar />
  <main class="pt-24 min-h-screen text-white bg-[#050505]">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_center,var(--tw-gradient-stops))] from-amber-900/10 via-black to-black -z-10"></div>

    <div class="container mx-auto px-4 md:px-6 py-8 pb-32 max-w-4xl">

      <div id="loading-overlay" class="flex flex-col items-center justify-center h-[70vh]">
        <div class="w-16 h-16 border-4 border-white/5 border-t-amber-500 rounded-full animate-spin"></div>
      </div>

      <div id="vips-admin-content" class="hidden">
        <div class="flex items-center gap-4 mb-8">
          <a href="/admin" class="text-gray-500 hover:text-white text-sm transition-colors">← Volver al panel</a>
          <div class="flex-grow border-t border-white/5"></div>
        </div>

        <div class="flex items-center gap-3 mb-8">
          <span class="text-3xl">👥</span>
          <h1 class="text-3xl font-black font-orbitron text-white uppercase">VIPs — Gestión</h1>
        </div>

        <VipsManager client:load initialVips={vips} />
      </div>

      <div id="access-denied" class="hidden flex flex-col items-center justify-center min-h-[60vh] text-center">
        <div class="text-8xl mb-6">🔒</div>
        <h2 class="text-3xl font-black font-orbitron text-white mb-2">ACCESO RESTRINGIDO</h2>
        <a href="/admin" class="mt-6 px-8 py-3 border border-white/10 rounded-full text-sm font-bold text-white hover:bg-white/10 transition">Volver</a>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { supabase } from '../../features/auth/lib/supabase';

  document.addEventListener('astro:page-load', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    const user = session?.user;

    const overlay = document.getElementById('loading-overlay');
    const content = document.getElementById('vips-admin-content');
    const denied = document.getElementById('access-denied');

    if (!user) {
      overlay?.classList.add('hidden');
      denied?.classList.remove('hidden');
      return;
    }

    let isAdmin = user.app_metadata?.is_admin === true;
    if (!isAdmin) {
      const { data } = await supabase.from('admin_users').select('user_id').eq('user_id', user.id).maybeSingle();
      isAdmin = Boolean(data);
    }

    overlay?.classList.add('hidden');
    if (isAdmin) {
      content?.classList.remove('hidden');
    } else {
      denied?.classList.remove('hidden');
    }
  });
</script>
