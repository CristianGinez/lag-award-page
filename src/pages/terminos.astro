---
import Layout from '../layouts/Layout.astro';
import Navbar from '../layouts/Navbar.astro';
import Footer from '../layouts/Footer.astro';
import { getCollection, render } from 'astro:content';

const entries = await getCollection('legal', ({ data }) => data.docSlug === 'terminos');
const entry = entries[0];
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
---

<Layout title="Términos y Condiciones - LAG AWARDS">
  <Navbar />
  <main class="pt-24 min-h-screen text-white bg-[#050505] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,var(--tw-gradient-stops))] from-red-900/10 via-black to-black -z-10"></div>

    <div class="container mx-auto px-6 py-12 max-w-4xl">
      <h1 class="text-4xl md:text-6xl font-black font-orbitron text-white mb-8 flex items-center gap-4">
        <span class="text-red-500">📜</span> Términos
      </h1>

      <div class="space-y-6 text-gray-300 prose prose-invert prose-headings:font-orbitron prose-h2:text-xl prose-h2:font-bold prose-h2:text-white max-w-none [&_h2]:border-l-4 [&_h2]:border-red-600 [&_h2]:pl-4 [&_h2]:bg-white/5 [&_h2]:p-4 [&_h2]:rounded-sm">
        <Content />
        <p class="text-xs text-gray-600 mt-8 text-center not-prose">
          Última actualización: {entry.data.lastUpdated.toLocaleDateString('es-AR', { year: 'numeric', month: 'long' })}. Nos reservamos el derecho de modificar estas reglas para asegurar la integridad del evento.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
