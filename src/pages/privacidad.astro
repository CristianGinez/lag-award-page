---
import Layout from '../layouts/Layout.astro';
import Navbar from '../layouts/Navbar.astro';
import Footer from '../layouts/Footer.astro';
import { getCollection, render } from 'astro:content';

const entries = await getCollection('legal', ({ data }) => data.docSlug === 'privacidad');
const entry = entries[0];
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
---

<Layout title="Política de Privacidad - LAG AWARDS">
  <Navbar />
  <main class="pt-24 min-h-screen text-white bg-[#050505] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,var(--tw-gradient-stops))] from-green-900/10 via-black to-black -z-10"></div>

    <div class="container mx-auto px-6 py-12 max-w-4xl">
      <h1 class="text-4xl md:text-6xl font-black font-orbitron text-white mb-8 flex items-center gap-4">
        <span class="text-green-500">🔒</span> Privacidad
      </h1>

      <div class="space-y-8 text-gray-300 leading-relaxed prose prose-invert prose-headings:font-orbitron max-w-none [&>div]:bg-[#111] [&>div]:border [&>div]:border-white/10 [&>div]:p-8 [&>div]:rounded-2xl">
        <Content />
        <p class="text-xs text-gray-600 mt-8 text-center not-prose">
          Última actualización: {entry.data.lastUpdated.toLocaleDateString('es-AR', { year: 'numeric', month: 'long' })}
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
