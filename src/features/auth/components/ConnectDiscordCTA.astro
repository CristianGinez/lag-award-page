---
// src/features/auth/components/ConnectDiscordCTA.astro
// CTA para vincular cuenta de Discord — se auto-oculta si ya está vinculado.
---

<section class="py-16 md:py-24 container mx-auto px-4 md:px-6 reveal-on-scroll" id="conectar-discord">
  <div class="relative rounded-3xl overflow-hidden border border-[#5865F2]/30 bg-gradient-to-br from-[#5865F2]/15 via-[#0a0a0a] to-[#0a0a0a] p-8 md:p-12">
    <div class="absolute -right-10 -top-10 w-48 h-48 bg-[#5865F2]/20 blur-3xl rounded-full pointer-events-none"></div>
    <div class="relative z-10 max-w-2xl">
      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#5865F2] mb-2">Comunidad</p>
      <h2 class="text-3xl md:text-4xl font-black font-orbitron text-white mb-3">
        Conectá tu cuenta de Discord
      </h2>
      <p class="text-gray-400 mb-6 text-sm leading-relaxed">
        Vinculá tu Discord al sitio para que tu perfil sea parte del TeamLag de verdad.
        Solo pedimos <span class="text-white/70">identify</span> — tu ID y nombre, nada más.
        Próximamente: badges por tu rol, actividad y más.
      </p>
      <button
        id="cta-connect-discord"
        class="inline-flex items-center gap-2 px-6 py-3 bg-[#5865F2] hover:bg-[#4752c4] text-white rounded-xl font-bold transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/></svg>
        Conectar Discord
      </button>
    </div>
  </div>
</section>

<script>
  import { supabase } from '@/features/auth/lib/supabase';
  import { startDiscordLink } from '@/features/auth/lib/discordLink';

  document.addEventListener('astro:page-load', async () => {
    const section = document.getElementById('conectar-discord');
    const btn = document.getElementById('cta-connect-discord') as HTMLButtonElement | null;
    if (!section || !btn) return;

    // Ocultar si ya tiene Discord vinculado
    const { data: { user } } = await supabase.auth.getUser();
    const hasDiscord = user?.identities?.some((i) => i.provider === 'discord');
    if (hasDiscord) {
      section.style.display = 'none';
      return;
    }

    btn.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login?next=/perfil';
        return;
      }
      btn.textContent = 'Redirigiendo…';
      btn.disabled = true;
      const { error } = await startDiscordLink();
      if (error) {
        btn.innerHTML = `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/></svg> Conectar Discord`;
        btn.disabled = false;
      }
    });
  });
</script>
