---
// src/features/community/components/VipCard.astro
import type { Vip } from '../types';
import { getPlatformInfo } from '../lib/platformIcons';

interface Props { vip: Vip; }
const { vip } = Astro.props;

const games = (vip.favorite_games ?? []).slice(0, 3);
const links = vip.links ?? [];
---

<a
  href={`/vips/${vip.slug}`}
  data-vip={vip.slug}
  class="group relative rounded-2xl overflow-hidden border bg-white/3 hover:bg-white/5 transition-all hover:scale-[1.03] hover:-translate-y-1 p-5 flex flex-col items-center gap-3 text-center"
  style={`--vip-color: ${vip.color}; border-color: ${vip.color}20;`}
>
  <!-- Glow on hover -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl pointer-events-none"
    style={`background: radial-gradient(circle at center, ${vip.color}18 0%, transparent 70%);`}
    aria-hidden="true"
  ></div>

  <!-- Accent line top -->
  <div class="absolute top-0 left-0 right-0 h-0.5" style={`background: ${vip.color}60;`}></div>

  <!-- Avatar -->
  {vip.avatar ? (
    <img
      src={vip.avatar}
      alt={vip.name}
      loading="lazy"
      decoding="async"
      width="64"
      height="64"
      transition:name={`vip-avatar-${vip.slug}`}
      class="relative w-16 h-16 rounded-full object-cover border-2 transition-all group-hover:shadow-[0_0_20px_var(--vip-color)]"
      style={`border-color: ${vip.color}50;`}
    />
  ) : (
    <div
      transition:name={`vip-avatar-${vip.slug}`}
      class="relative w-16 h-16 rounded-full flex items-center justify-center text-2xl font-black font-orbitron border-2 transition-all group-hover:shadow-[0_0_20px_var(--vip-color)]"
      style={`background: ${vip.color}15; border-color: ${vip.color}40; color: ${vip.color};`}
    >
      {vip.name.charAt(0)}
    </div>
  )}

  <!-- Info -->
  <div class="relative z-10 flex-1">
    <p class="text-[10px] font-bold uppercase tracking-widest font-mono" style={`color: ${vip.color};`}>{vip.role}</p>
    <div class="flex items-center justify-center gap-1.5 mt-0.5">
      <p transition:name={`vip-name-${vip.slug}`} class="text-white font-black font-orbitron text-sm uppercase tracking-tight leading-tight">{vip.name}</p>
      {vip.user_id && (
        <span class="text-[9px] bg-green-500/20 text-green-400 border border-green-500/30 px-1 py-0.5 rounded font-mono" title="Cuenta verificada">✓</span>
      )}
    </div>
    {vip.bio && (
      <p class="text-gray-500 text-[11px] mt-1.5 leading-relaxed line-clamp-2">{vip.bio}</p>
    )}
  </div>

  <!-- Games chips -->
  {games.length > 0 && (
    <div class="relative z-10 flex flex-wrap gap-1 justify-center">
      {games.map((g) => (
        <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-gray-500 truncate max-w-[80px]">{g}</span>
      ))}
    </div>
  )}

  <!-- Links row -->
  {links.length > 0 && (
    <div class="relative z-10 flex items-center gap-2 mt-auto flex-wrap justify-center">
      {links.map((link) => {
        const info = getPlatformInfo(link.platform);
        return (
          <span
            onclick={`event.preventDefault(); window.open('${link.url}','_blank')`}
            class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider opacity-40 group-hover:opacity-80 transition-opacity cursor-pointer"
            style={`color: ${info.color};`}
            title={link.label ?? info.label}
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <Fragment set:html={info.svg} />
            </svg>
          </span>
        );
      })}
    </div>
  )}
</a>
