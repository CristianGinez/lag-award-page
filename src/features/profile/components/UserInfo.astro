---
// src/features/profile/components/UserInfo.astro
---

<!-- Avatar frame with gradient ring -->
<div class="relative shrink-0">
  <div
    class="w-24 h-24 rounded-xl p-0.5"
    style="background: linear-gradient(135deg, #7c3aed, #db2777, #f59e0b); box-shadow: 0 0 30px rgba(124,58,237,0.4), 0 8px 32px rgba(0,0,0,0.6);"
  >
    <div class="w-full h-full rounded-[10px] overflow-hidden bg-[#0d0d1f]">
      <img id="profile-avatar" src="" alt="Avatar" class="w-full h-full object-cover" />
    </div>
  </div>
  <!-- Online indicator -->
  <div
    class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-green-500 border-[3px] border-[#050505]"
    style="box-shadow: 0 0 8px rgba(34,197,94,0.7);"
  ></div>
</div>

<!-- Name + meta -->
<div class="pb-3">
  <h2
    id="profile-name"
    class="text-xl md:text-2xl font-black font-orbitron text-white"
    style="text-shadow: 0 2px 20px rgba(0,0,0,0.8);"
  >
    Usuario
  </h2>
  <div class="flex items-center gap-2 mt-2 flex-wrap">
    <p id="profile-email" class="text-[10px] text-gray-500 font-mono">...</p>
  </div>
</div>
