---
// src/shared/components/HeroSection.astro
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Fondo: video + gradiente -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/40 to-[#050505] z-10"></div>
    <video
      id="hero-video"
      autoplay loop muted playsinline
      class="w-full h-full object-cover opacity-50"
      aria-hidden="true"
    >
      <source src="https://res.cloudinary.com/dkjaq3i9p/video/upload/v1780991729/ahora_haz_un_video_no_de_pres_lacfee.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Botón mute/unmute -->
  <button
    id="hero-mute-btn"
    aria-label="Activar sonido"
    class="absolute bottom-16 right-6 z-30 flex items-center gap-2 px-3 py-2 rounded-full bg-black/50 border border-white/15 text-white/70 hover:text-white hover:bg-black/70 hover:border-white/30 transition-all duration-200 backdrop-blur-sm text-xs font-mono select-none"
  >
    <!-- Icono muted (visible por defecto) -->
    <svg id="icon-muted" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
    </svg>
    <!-- Icono unmuted (oculto por defecto) -->
    <svg id="icon-unmuted" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
    </svg>
    <span id="mute-label">Sonido</span>
  </button>

  <!-- Blobs de glow (flotan con GSAP) -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="hero-blob hero-blob-red absolute top-1/4 left-1/4 w-96 h-96 bg-red-600/10 rounded-full blur-[100px]"></div>
    <div class="hero-blob hero-blob-purple absolute top-1/3 right-1/4 w-80 h-80 bg-purple-600/10 rounded-full blur-[100px]"></div>
    <div class="hero-blob hero-blob-blue absolute bottom-1/4 left-1/3 w-64 h-64 bg-blue-600/10 rounded-full blur-[80px]"></div>
  </div>

  <!-- Línea decorativa superior -->
  <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-red-500 via-purple-500 to-blue-500 shadow-[0_0_15px_rgba(168,85,247,0.5)] z-20" aria-hidden="true"></div>

  <!-- Contenido -->
  <div class="relative z-20 text-center px-4 max-w-5xl mx-auto py-24">

    <!-- Título -->
    <h1 id="hero-title" class="text-5xl md:text-7xl lg:text-8xl font-black font-orbitron text-transparent bg-clip-text bg-gradient-to-b from-white via-gray-200 to-gray-500 mb-4 leading-none tracking-tighter drop-shadow-[0_0_35px_rgba(255,255,255,0.2)]">
      TEAM<span class="bg-gradient-to-r from-red-500 via-purple-500 to-blue-500 text-transparent bg-clip-text">LAG</span>
    </h1>

    <!-- Tagline -->
    <p id="hero-tagline" class="text-lg md:text-xl text-gray-400 font-light mb-10 max-w-2xl mx-auto tracking-wide">
      La comunidad de LAGartovich — Awards, Parsec League y mucho más.
    </p>

    <!-- CTAs -->
    <div id="hero-ctas" class="flex flex-col gap-5 justify-center items-center w-full">

      <!-- Bot CTA — protagonista -->
      <a
        href="/bot"
        class="hero-bot-cta group relative w-full max-w-lg flex items-center gap-5 px-6 py-5 rounded-2xl text-white overflow-hidden transition-all duration-300 hover:scale-[1.03]"
      >
        <!-- Glow de fondo animado -->
        <div class="hero-bot-glow absolute inset-0 rounded-2xl" aria-hidden="true"></div>
        <!-- Borde degradado -->
        <div class="absolute inset-0 rounded-2xl border border-purple-500/40 group-hover:border-purple-400/80 transition-colors duration-300" aria-hidden="true"></div>
        <!-- Shimmer sweep on hover -->
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.06) 50%, transparent 60%);" aria-hidden="true"></div>

        <!-- Avatar del bot -->
        <div class="relative shrink-0">
          <div class="absolute inset-0 rounded-full blur-md opacity-70 group-hover:opacity-100 transition-opacity" style="background: radial-gradient(circle, #a855f7, #3b82f6); transform: scale(1.3);"></div>
          <img
            src="https://cdn.discordapp.com/app-icons/1503802588510818496/841251b24d5db8e9ba3a19c87e894442.png?size=128"
            alt="LAG Bot"
            width="64"
            height="64"
            decoding="async"
            class="relative z-10 w-14 h-14 rounded-full object-cover border-2 border-purple-400/60 group-hover:border-purple-300 transition-colors shadow-[0_0_20px_rgba(168,85,247,0.5)]"
          />
          <!-- Indicador online -->
          <span class="absolute bottom-0.5 right-0.5 w-3 h-3 bg-green-500 rounded-full border-2 border-[#050505] z-20 shadow-[0_0_6px_rgba(34,197,94,0.8)]"></span>
        </div>

        <!-- Texto -->
        <div class="relative z-10 flex flex-col items-start gap-0.5 flex-1 min-w-0">
          <span class="text-[10px] font-mono text-purple-300/80 uppercase tracking-[0.2em]">Nuevo</span>
          <span class="font-black font-orbitron uppercase tracking-tight text-lg leading-none text-white group-hover:text-purple-100 transition-colors">Conocé al Bot de Discord</span>
          <span class="text-xs text-gray-400 group-hover:text-gray-300 transition-colors mt-0.5 truncate">Comandos, música, stats del servidor y más</span>
        </div>

        <!-- Flecha -->
        <svg class="w-5 h-5 relative z-10 shrink-0 text-purple-400 group-hover:text-white group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
      </a>

      <!-- Botones secundarios -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center w-full max-w-lg">
        <a
          href="https://discord.gg/teamlag"
          target="_blank"
          rel="noopener noreferrer"
          class="group w-full sm:w-auto px-7 py-3.5 bg-[#5865F2] hover:bg-[#4752C4] text-white font-black font-orbitron uppercase tracking-widest rounded-xl transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(88,101,242,0.4)] flex items-center justify-center gap-2 text-sm"
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037 13.46 13.46 0 0 0-2.314 4.249 13.473 13.473 0 0 0-2.315-4.249.073.073 0 0 0-.079-.037 19.793 19.793 0 0 0-4.885 1.515.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.896 19.896 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
          </svg>
          Unite al Discord
        </a>

        <a
          href="#el-team"
          class="group w-full sm:w-auto px-7 py-3.5 bg-white/5 hover:bg-white/10 text-white font-bold font-orbitron uppercase tracking-widest rounded-xl border border-white/10 hover:border-white/30 transition-all hover:scale-105 text-sm scroll-mt-24 flex items-center justify-center"
        >
          Conocé al Team →
        </a>
      </div>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 animate-bounce opacity-40" aria-hidden="true">
    <div class="w-0.5 h-8 bg-gradient-to-b from-white/0 to-white/60 rounded-full"></div>
  </div>

</section>

<style>
  /* Previene FOUC — GSAP anima desde estos estados */
  #hero-title,
  #hero-tagline,
  #hero-ctas {
    opacity: 0;
  }

  /* Bot CTA — fondo con glow pulsante */
  .hero-bot-cta {
    background: linear-gradient(135deg, rgba(88,28,135,0.55) 0%, rgba(30,64,175,0.45) 100%);
    backdrop-filter: blur(12px);
  }

  .hero-bot-glow {
    background: linear-gradient(135deg, rgba(147,51,234,0.15) 0%, rgba(59,130,246,0.12) 100%);
    animation: botGlowPulse 3s ease-in-out infinite;
  }

  .hero-bot-cta:hover .hero-bot-glow {
    animation: botGlowPulseHover 1.5s ease-in-out infinite;
  }

  @keyframes botGlowPulse {
    0%, 100% { opacity: 0.7; }
    50%       { opacity: 1; }
  }

  @keyframes botGlowPulseHover {
    0%, 100% { opacity: 0.9; box-shadow: inset 0 0 30px rgba(147,51,234,0.15); }
    50%       { opacity: 1;   box-shadow: inset 0 0 50px rgba(147,51,234,0.25); }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const FROM = { opacity: 0, y: 28 } as const;
  const TO   = { opacity: 1, y: 0, ease: 'power3.out', clearProps: 'transform' } as const;

  document.addEventListener('astro:page-load', () => {
    // Mute toggle
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const muteBtn = document.getElementById('hero-mute-btn');
    const iconMuted = document.getElementById('icon-muted');
    const iconUnmuted = document.getElementById('icon-unmuted');
    const muteLabel = document.getElementById('mute-label');

    if (video && muteBtn) {
      muteBtn.addEventListener('click', () => {
        video.muted = !video.muted;
        const muted = video.muted;
        iconMuted?.classList.toggle('hidden', !muted);
        iconUnmuted?.classList.toggle('hidden', muted);
        if (muteLabel) muteLabel.textContent = muted ? 'Sonido' : 'Silenciar';
        if (muteBtn) muteBtn.setAttribute('aria-label', muted ? 'Activar sonido' : 'Silenciar');
      });
    }

    if (!document.getElementById('hero-title')) return;

    // Timeline secuencial de entrada
    const tl = gsap.timeline();

    tl.fromTo('#hero-title',   FROM, { ...TO, duration: 0.7 })
      .fromTo('#hero-tagline', FROM, { ...TO, duration: 0.5 }, '-=0.35')
      .fromTo('#hero-ctas',    FROM, { ...TO, duration: 0.5 }, '-=0.25');

    // Blobs flotantes — movimiento continuo suave
    gsap.to('.hero-blob-red',    { x: 22, y: -18, duration: 6,   repeat: -1, yoyo: true, ease: 'sine.inOut' });
    gsap.to('.hero-blob-purple', { x: -18, y: 22, duration: 7.5, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 1.2 });
    gsap.to('.hero-blob-blue',   { x: 12,  y: 16, duration: 5.5, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 2.5 });
  });
</script>
